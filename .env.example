# Copy this file's values into real environment variables before running the backend.
# Spring Boot does NOT load .env files automatically -- see README.md "Environment Variables".

# Required. Signing key for JWT tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-secret

# Optional -- defaults shown match backend/src/main/resources/application.properties
DB_URL=jdbc:mysql://localhost:3306/contact_management_db
DB_USERNAME=root
DB_PASSWORD=7879
